{
  "name": "@lerna-labs/hydra-sdk-monorepo",
  "description": "A collection of helpful code and examples for building applications leveraging Hydra technology",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check packages/ examples/",
    "lint:fix": "biome check --write packages/ examples/",
    "typecheck": "tsc -p packages/core/tsconfig.build.json --noEmit && tsc -p packages/proof/tsconfig.build.json --noEmit && tsc -p packages/orchestrator/tsconfig.build.json --noEmit && tsc -p examples/local-currency/tsconfig.json --noEmit && tsc -p examples/notary/tsconfig.json --noEmit",
    "start:api": "tsx watch examples/local-currency/index.ts",
    "start:orchestrator": "tsx packages/orchestrator/src/index.ts",
    "build": "npm run build -ws",
    "build:sdk": "npm run build -w @lerna-labs/hydra-sdk",
    "build:proof": "npm run build -w @lerna-labs/hydra-proof",
    "api:extract": "npm run build && tsx scripts/extract-api.ts",
    "api:compare": "tsx scripts/compare-api.ts",
    "docs:api": "typedoc",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "npm run build && node scripts/publish-packages.mjs",
    "changeset:snapshot": "changeset version --snapshot rc",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/**/*.{ts,tsx}": ["biome check --write"],
    "examples/**/*.{ts,tsx}": ["biome check --write"]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lerna-labs/hydra-sdk.git"
  },
  "author": "Adam Dean <adam@crypto2099.io>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/lerna-labs/hydra-sdk/issues"
  },
  "homepage": "https://github.com/lerna-labs/hydra-sdk#readme",
  "workspaces": {
    "packages": [
      "packages/core",
      "packages/proof",
      "packages/orchestrator",
      "examples/local-currency",
      "examples/notary"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@changesets/cli": "^2.31.1",
    "@types/express": "^5.0.3",
    "@types/ws": "^8.18.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "libsodium-wrappers-sumo": "0.7.15",
    "npm": "11.19.1",
    "minimatch": "^9.0.9",
    "rimraf": {
      "glob": {
        "minimatch": "^3.1.4"
      }
    },
    "@cardano-ogmios/client": {
      "ws": "^7.5.11"
    },
    "body-parser": "^2.3.0",
    "brace-expansion@1": "^1.1.16",
    "brace-expansion@2": "^2.1.4",
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.6",
    "glob@10": "^10.5.0",
    "ip-address": "^10.3.1",
    "js-yaml@3": "^3.15.1",
    "js-yaml@4": "^4.3.1",
    "linkify-it": "^5.0.2",
    "lodash": "^4.18.0",
    "markdown-it": "^14.2.0",
    "path-to-regexp": "^8.4.0",
    "picomatch@2": "^2.3.2",
    "picomatch@4": "^4.0.4",
    "postcss-selector-parser@6": "^6.1.3",
    "qs": "^6.16.0",
    "undici": "^6.28.0"
  },
  "dependencies": {
    "@emurgo/cardano-message-signing-nodejs": "^1.1.0",
    "@emurgo/cardano-serialization-lib-nodejs": "^15.0.3",
    "@meshsdk/core": "1.9.0-beta.99",
    "@meshsdk/core-csl": "1.9.0-beta.99",
    "@meshsdk/hydra": "1.9.0-beta.99",
    "@noble/hashes": "^2.0.1",
    "axios": "^1.18.0",
    "commander": "^14.0.1",
    "dotenv": "^17.2.1",
    "express": "^5.2.1",
    "tx3-sdk": "^0.7.0",
    "utf-8-validate": "^5.0.2",
    "ws": "^8.21.0"
  }
}
